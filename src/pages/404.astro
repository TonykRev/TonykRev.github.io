---
import BaseLayout from "../layouts/BaseLayout.astro";
import { DOMAINS } from "../lib/content-model";
---

<BaseLayout title="Not found | HSEC">
  <section class="not-found"><p class="technical-label">Signal lost / 404</p><h1>Nothing here.</h1><p>The requested page is not part of this notebook.</p><nav aria-label="Recovery"><a href="/">Return home</a><a href="/research/">Browse research</a>{DOMAINS.map((domain) => <a href={`/domains/${domain}/`}>{domain}</a>)}</nav></section>
</BaseLayout>

<style>
  .not-found { padding: 6rem 0; }
  h1 { font-size: clamp(3rem, 8vw, 7rem); line-height: .95; margin: 1rem 0; }
  .technical-label { color: var(--color-accent); font-family: var(--font-mono); text-transform: uppercase; }
  nav { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 3rem; }
</style>
