---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResearchList from "../../components/research/ResearchList.astro";
import ResearchFilters from "../../components/research/ResearchFilters.astro";
import { assertUniqueResearchIds, visibleResearch } from "../../lib/research";

const collection = await getCollection("research");
const entries = collection.map(({ id, data }) => ({ id, ...data }));
assertUniqueResearchIds(entries);
const research = visibleResearch(entries);
---

<BaseLayout title="Research | HSEC">
  <header class="page-heading"><p class="technical-label">Research index</p><h1>Research.</h1><p>Deep research, case studies, and practical guides for modern defenders.</p></header>
  <ResearchFilters entries={research} />
  <ResearchList entries={research} />
</BaseLayout>

<style>
  .page-heading { border-bottom: 1px solid var(--color-line); padding: 5rem 0 3rem; }
  h1 { font-size: clamp(3rem, 8vw, 7rem); line-height: .95; margin: 1rem 0; }
  .technical-label { color: var(--color-accent); font-family: var(--font-mono); text-transform: uppercase; }
</style>
