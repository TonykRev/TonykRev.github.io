---
import type { Domain, ResearchFormat } from "../../lib/content-model";

interface Props { title: string; published: Date; domain: Domain; format: ResearchFormat; }
const { title, published, domain, format } = Astro.props;
const publishedLabel = published.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric", timeZone: "UTC" });
---

<header class="article-header">
  <p class="technical-label">{domain} / {format}</p>
  <h1>{title}</h1>
  <p class="published">Published {publishedLabel}</p>
</header>

<style>
  .article-header { border-bottom: 1px solid var(--color-line); margin-bottom: 3rem; padding: 4rem 0 2rem; }
  .technical-label, .published { color: var(--color-muted); font-family: var(--font-mono); font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; }
  h1 { font-size: clamp(3rem, 8vw, 7rem); line-height: .95; margin: 1.5rem 0; max-width: 12ch; }
</style>
