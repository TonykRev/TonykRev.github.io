<div class="reading-progress" data-reading-progress role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>

<script>
  const bar = document.querySelector<HTMLElement>("[data-reading-progress]");
  const article = document.querySelector<HTMLElement>("[data-article-body]");

  if (bar && article) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const start = article.getBoundingClientRect().top + window.scrollY;
      const end = start + article.offsetHeight - window.innerHeight;
      const percent = Math.round(Math.min(100, Math.max(0, ((window.scrollY - start) / Math.max(1, end - start)) * 100)));
      bar.style.setProperty("--reading-progress", `${percent}%`);
      bar.setAttribute("aria-valuenow", String(percent));
    };
    const schedule = () => {
      if (!frame) frame = window.requestAnimationFrame(update);
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    schedule();
  }
</script>

<style>
  .reading-progress { background: var(--color-line); height: 2px; inset: 0 0 auto; position: fixed; z-index: 10; }
  .reading-progress::before { background: var(--color-accent); content: ""; display: block; height: 100%; width: var(--reading-progress, 0%); }
  @media (prefers-reduced-motion: reduce) { .reading-progress::before { transition: none; } }
</style>
