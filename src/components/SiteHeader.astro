---
import { SITE } from "../site.config";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">{SITE.title}</a>
    <nav aria-label="Primary">
      <ul class="site-header__links">
        <li><a href="/research/">Research</a></li>
        <li><a href="/projects/">Projects</a></li>
        <li><a href="/about/">About</a></li>
      </ul>
    </nav>
    <button class="search-trigger" type="button" data-search-open aria-label="Search research">Search <kbd>⌘K</kbd></button>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-line);
  }

  .site-header__inner {
    align-items: center;
    display: flex;
    gap: var(--space-2);
    margin-inline: auto;
    max-width: var(--content-width);
    padding: var(--space-2);
  }

  .site-header__brand,
  .site-header__links {
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-header__brand {
    font-weight: 700;
    text-decoration: none;
  }

  .site-header__links {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__links a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .site-header__links a:hover {
    color: var(--color-accent);
  }

  nav { margin-left: auto; }

  .search-trigger { background: transparent; border: 1px solid var(--color-line); color: var(--color-text); cursor: pointer; font-family: var(--font-mono); font-size: .72rem; padding: .4rem .55rem; text-transform: uppercase; }
  .search-trigger:hover { border-color: var(--color-accent); color: var(--color-accent); }
  kbd { color: var(--color-muted); font: inherit; margin-left: .25rem; }

  @media (max-width: 650px) { .site-header__links { gap: .75rem; } .search-trigger kbd { display: none; } }
</style>
