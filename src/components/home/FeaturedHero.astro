---
import SignalRing from "./SignalRing.astro";
import type { ResearchSummary } from "../../lib/content-model";

interface Props { entry: ResearchSummary; }
const { entry } = Astro.props;
---

<section class="featured-hero" aria-labelledby="featured-title">
  <div class="hero-signal"><SignalRing /></div>
  <p class="technical-label">01 / Featured investigation</p>
  <h1 id="featured-title">{entry.title}.</h1>
  <p class="hero-summary">{entry.summary}</p>
  <a class="hero-link" href={`/research/${entry.id}/`}>Read featured research <span aria-hidden="true">↗</span></a>
  <a class="scroll-cue" href="#domain-index">Scroll to explore <span aria-hidden="true">↓</span></a>
</section>

<style>
  .featured-hero { min-height: 50rem; padding-block: 5rem 8rem; position: relative; }
  .hero-signal { position: absolute; right: 8%; top: 6rem; }
  .technical-label, .filter-label { color: var(--color-accent); font-family: var(--font-mono); font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; }
  h1 { font-size: clamp(3.5rem, 9vw, 8rem); line-height: .95; max-width: 10ch; margin: 2rem 0; }
  .hero-summary { max-width: 32rem; }
  .hero-link, .scroll-cue { display: block; font-family: var(--font-mono); margin-top: 2rem; width: fit-content; }
  .scroll-cue { color: var(--color-muted); margin-top: 8rem; }
  @media (max-width: 700px) { .hero-signal { opacity: .35; right: 0; } .featured-hero { min-height: 48rem; } }
</style>
